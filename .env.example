# Bet Tracking API — environment variables
# Copy to .env and fill in values before starting the service.

# Bearer token required on all API requests.
# The Cache API must use the same token in its BET_API_URL calls.
BET_API_TOKEN=change-me-strong-secret

# Port this service listens on (default 5002).
API_PORT=5002

# Path to the SQLite database file.
# Default: bets.db in the same directory as main.py
# BET_DB_PATH=/home/ubuntu/services/bet-tracking-api/bets.db

# URL of the internal Stats API (realtime_data_fetch).
# Must be reachable from this service (same VPS → localhost is fine).
STATS_API_URL=http://localhost:8001

# Optional bearer token for the Stats API.
# STATS_API_TOKEN=

# Request timeout for Stats API calls in seconds (default 3.0).
# STATS_API_TIMEOUT=3.0
